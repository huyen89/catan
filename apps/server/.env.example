# Hexhaven server configuration. Copy to apps/server/.env (loaded automatically if present);
# real environment variables take precedence.

PORT=3000
HOST=0.0.0.0
# SQLite file (directory is created). ':memory:' for throwaway runs.
DB_PATH=./data/hexhaven.sqlite
# Required, at least 16 characters. Keys the session-token hashes: rotating it logs everyone out.
SESSION_SECRET=
# Public URL players use (e.g. https://hexhaven.example.com). Enables the socket Origin check
# and Secure cookies when https.
PUBLIC_ORIGIN=

# Google Identity Services client id. Leave empty to disable Google login.
GOOGLE_CLIENT_ID=
# Optional comma-separated allow-list of Google account emails.
ALLOWED_EMAILS=
# Optional code guests must enter to log in.
GUEST_INVITE_CODE=

# '1' enables /api/test/* routes, instant bots and a short reconnect grace. Never in production.
TEST_MODE=
# Disconnected seats are handed to a bot after this long (default 30000; 1500 in TEST_MODE).
RECONNECT_GRACE_MS=
# Base bot "thinking" delay, jittered ±30% (default 900; 0 in TEST_MODE).
BOT_DELAY_MS=
# Built web app to serve (default: apps/web/dist).
WEB_DIST=

# Voice relay (TURN): cloudflare | coturn | none
TURN_PROVIDER=none
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
COTURN_URLS=
COTURN_SECRET=
TURN_TTL_SEC=3600
