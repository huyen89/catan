# Hexhaven configuration. Copy to `.env` (never commit `.env`) and fill in the values.
# Placeholders below are NOT real secrets. See docs/DEPLOY.md for where each value comes from.

# ---------------------------------------------------------------- server
# production for a real deployment (the Docker image sets it for you); leave unset for `pnpm dev`.
# NODE_ENV=production
# Port the server listens on (inside Docker this is fixed to 3000).
PORT=3000
# REQUIRED in production: the server refuses to start without it.
# Public URL friends open, exactly as in the browser address bar (scheme + host, no trailing slash).
# Used for origin checks and secure cookies, and must match the Google "Authorized JavaScript
# origin". Dev: http://localhost:5173
PUBLIC_ORIGIN=https://hexhaven.example.com
# Long random string used to sign session cookies (at least 32 characters).
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# SQLite database file (inside Docker this is fixed to /data/hexhaven.sqlite on the data volume).
DB_PATH=./data/hexhaven.sqlite
# Built web app served by the server (inside Docker: /app/apps/web/dist). Defaults to apps/web/dist.
# WEB_DIST=./apps/web/dist
# Test-only shortcuts for automated tests. Never enable on a real deployment.
TEST_MODE=0

# ---------------------------------------------------------------- sign-in / access control
# Google OAuth "Web application" client ID (ends in .apps.googleusercontent.com). Empty = no Google button.
GOOGLE_CLIENT_ID=
# Comma-separated Google account emails allowed to sign in, e.g. alice@gmail.com,bob@gmail.com
ALLOWED_EMAILS=
# Code guests must enter to play without a Google account. Share it only with your friends.
GUEST_INVITE_CODE=change-me-invite-code

# ---------------------------------------------------------------- game behaviour
# How long a disconnected player's seat waits before a bot takes over (milliseconds).
RECONNECT_GRACE_MS=60000
# Pause before each bot move so humans can follow along (milliseconds).
BOT_DELAY_MS=800

# ---------------------------------------------------------------- voice (TURN relay)
# Voice audio goes browser-to-browser. When a direct path is impossible (strict NATs, mobile
# networks) it is relayed by a TURN server. UDP cannot pass through Cloudflare Tunnel.
# cloudflare = Cloudflare Realtime TURN (recommended) · coturn = your own server · none = STUN only
TURN_PROVIDER=cloudflare
# Cloudflare dashboard → Realtime → TURN Server: the "Turn Token ID" and its API token.
CF_TURN_KEY_ID=your-turn-key-id
CF_TURN_API_TOKEN=your-turn-api-token
# Only for TURN_PROVIDER=coturn: comma-separated URLs and the shared secret (openssl rand -hex 32).
COTURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
COTURN_SECRET=change-me-coturn-shared-secret
# Lifetime of the TURN credentials handed to signed-in players (seconds, 60..172800, default 3600 (1h)).
# TURN_TTL_SEC=3600
# Most people in one room's voice chat at once (2..16, default 8). Every member sends audio to
# every other member, so large groups strain phones and slow uplinks.
VOICE_MAX_PEERS=8

# ---------------------------------------------------------------- docker compose extras
# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → token (used by the cloudflared container).
TUNNEL_TOKEN=paste-your-tunnel-token-here
# Optional coturn container (compose profile "coturn"): realm and your public IP if auto-detection fails.
COTURN_REALM=hexhaven.example.com
COTURN_EXTERNAL_IP=
